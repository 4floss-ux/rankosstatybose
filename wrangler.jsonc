{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankosstatybose",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}

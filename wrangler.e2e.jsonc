{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statybos24-e2e-test",
  "main": "./e2e/worker.mjs",
  "compatibility_date": "2026-09-25",
  "keep_vars": true,
  "assets": {
    "directory": "./dist-e2e",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}

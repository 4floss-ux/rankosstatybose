{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statybos24-design-test",
  "main": "./worker.staging.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "test.statybos24.lt",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
